# Driftly's own app database (Supabase project -> Settings -> Database -> connection string)
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# 32 random bytes, base64. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=

# Sign-in (Supabase Auth): Supabase project -> Project Settings -> API.
# Leave both empty to run locally without sign-in. Production refuses to serve pages without them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: comma-separated emails allowed to sign in. Empty = anyone who can sign up.
ALLOWED_EMAILS=
